{
	"name": "n8n-nodes-liner",
	"version": "0.1.1",
	"description": "Use Liner search, quick answer, AI Search, and Deep Research APIs in n8n workflows.",
	"license": "MIT",
	"homepage": "https://github.com/mjkang-estrella/n8n-nodes-liner",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"liner",
		"ai-search",
		"search-api",
		"deep-research"
	],
	"author": {
		"name": "Liner"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mjkang-estrella/n8n-nodes-liner.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LinerApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Liner/Liner.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.33.0",
		"eslint": "9.29.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
